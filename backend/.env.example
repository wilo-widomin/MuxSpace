# --- Configuración del backend ---
# Copia este archivo a backend/.env y edita los valores para tu despliegue:
#   cp backend/.env.example backend/.env
# Todos los valores tienen un default razonable en config.py, así que .env
# solo es necesario para personalizar (credenciales, dominio CORS, raíces
# de directorios, etc.).

# --- Autenticación (login del panel) ---
MUXSPACE_AUTH_ENABLED=true

# Modo de validación de credenciales:
#   env (default) -> usuario/contraseña fijos de abajo.
#   pam           -> se entra con el usuario y contraseña de Linux del
#                    usuario que ejecuta el backend (no hace falta duplicar
#                    la contraseña aquí; USERNAME/PASSWORD se ignoran).
#MUXSPACE_AUTH_MODE=pam

# Servicio PAM a usar en modo pam (default: login).
#MUXSPACE_PAM_SERVICE=login

# Credenciales del modo env. La contraseña es OBLIGATORIA: quien entre al
# panel puede ejecutar comandos como el usuario que corre el backend, así
# que el backend se niega a arrancar si la dejas vacía o la pones en
# 'admin'. Genera una con: openssl rand -base64 24
MUXSPACE_USERNAME=admin
MUXSPACE_PASSWORD=

# Horas de validez de la sesión iniciada en el login (default: 168 = 7 días).
#MUXSPACE_SESSION_TTL_HOURS=168

# Publica /docs, /redoc y /openapi.json. Por defecto NO: FastAPI las sirve
# sin autenticación, y ahí va el mapa completo de un panel que ejecuta
# comandos (send-command, launch, run, subidas) con sus esquemas. Actívalo
# solo en desarrollo, si quieres el explorador de la API.
#MUXSPACE_DOCS_ENABLED=false

# La cookie de sesión se marca `Secure` (solo viaja cifrada) por defecto,
# que es lo correcto si sirves el panel por HTTPS tras un reverse proxy.
# Ponlo a false SOLO para desarrollo contra http://localhost: con `Secure`
# el navegador no guarda la cookie en HTTP y el login no funcionaría.
#MUXSPACE_COOKIE_SECURE=true

# --- Servidor backend ---
# 127.0.0.1 = solo acceso local. Usa 0.0.0.0 si vas a poner un reverse
# proxy (Caddy/Nginx) delante para alcanzarlo desde fuera de la máquina.
MUXSPACE_HOST=127.0.0.1
MUXSPACE_PORT=8000

# Binario de tmux (cambiar si no está en el PATH).
MUXSPACE_TMUX_BINARY=tmux

# Orígenes CORS permitidos. En producción el frontend lo sirve el propio
# backend (mismo origen), así que esto casi solo importa en desarrollo.
# Añade tu dominio si lo expones tras un proxy.
MUXSPACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Raíces de directorio bajo las que se ofrecen sugerencias de autocompletado
# al escribir un "directorio" en el panel. `~` se expande al home del usuario
# que ejecuta el backend (las sugerencias siempre arrancan "a partir de mi
# usuario"). Acepta JSON o lista separada por comas.
MUXSPACE_DIR_SUGGESTION_ROOTS=["~"]